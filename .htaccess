# Taroti - Configuración Apache para Node.js en Hostinger
# Redirige todo el tráfico al servidor Node.js en puerto 3000

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Permitir archivos estáticos (si existen físicamente)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redirigir todo a Node.js mediante proxy
  RewriteRule ^(.*)$ http://localhost:3000/$1 [P,L]
</IfModule>

<IfModule mod_headers.c>
  # Preservar el host original
  RequestHeader set X-Forwarded-Proto "http"
  RequestHeader set X-Forwarded-Host "%{HTTP_HOST}e"
</IfModule>

# Comprimir contenido para mejor rendimiento
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
