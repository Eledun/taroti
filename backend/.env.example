# 🔮 Taroti Backend - Variables de Entorno
# Copia este archivo a .env y completa con tus valores reales

# ========================================
# 📊 BASE DE DATOS
# ========================================
DATABASE_URL="mysql://usuario:password@localhost:3306/taroti_dev"

# ========================================
# 🔐 SEGURIDAD - JWT
# ========================================
# Genera secrets seguros con: openssl rand -base64 32
JWT_SECRET="tu-secret-super-seguro-aqui-minimo-32-caracteres"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Admin JWT (separado del usuario regular)
ADMIN_JWT_SECRET="otro-secret-diferente-para-admin-minimo-32-caracteres"
ADMIN_JWT_EXPIRES_IN="4h"

# ========================================
# 👤 CREDENCIALES DE ADMINISTRADOR
# ========================================
ADMIN_USER="admin"
# Genera el hash con: node -e "console.log(require('bcrypt').hashSync('tu_password', 10))"
ADMIN_PASSWORD_HASH="$2b$10$..."

# ========================================
# 🔑 SERVICIOS EXTERNOS
# ========================================

# Google OAuth 2.0
# Obtén desde: https://console.cloud.google.com/apis/credentials
# Formato: 123456789012-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"

# OpenAI API
# Obtén desde: https://platform.openai.com/api-keys
# Formato: sk-proj-xxxxx
OPENAI_API_KEY="sk-proj-tu-api-key-aqui"

# Mercado Pago
# Obtén desde: https://www.mercadopago.cl/developers/panel/app
# Usa el Access Token (no el Public Key)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-tu-access-token-aqui"

# ========================================
# 🌐 CONFIGURACIÓN DEL SERVIDOR
# ========================================
NODE_ENV="development"  # development | production
PORT="4000"

# URLs públicas (importantes para CORS y webhooks)
BACKEND_URL="http://localhost:4000/api"
FRONTEND_URL="http://localhost:5173"

# ========================================
# 📝 NOTAS IMPORTANTES
# ========================================
# 1. NUNCA compartas este archivo con valores reales
# 2. Agrega .env al .gitignore
# 3. En producción usa variables de entorno del servidor
# 4. Los secrets deben ser diferentes entre desarrollo y producción
# 5. El BACKEND_URL en producción debe apuntar al dominio público
#    para que los webhooks de Mercado Pago funcionen
