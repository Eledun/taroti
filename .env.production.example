NODE_ENV=production
PORT=4000

# ====================================
# MYSQL DE HOSTINGER
# ====================================
# Obtén estas credenciales desde:
# hPanel → Bases de Datos → Administrador de MySQL
DATABASE_URL="mysql://u616221621_taroti:TU_PASSWORD_MYSQL@localhost:3306/u616221621_taroti?charset=utf8mb4"

# ====================================
# JWT SECRETS
# ====================================
# Genera secrets seguros con: openssl rand -base64 32
JWT_SECRET="REEMPLAZAR_CON_SECRET_SEGURO"
REFRESH_TOKEN_EXPIRES_IN="30d"
JWT_EXPIRES_IN="7d"

ADMIN_JWT_SECRET="REEMPLAZAR_CON_OTRO_SECRET_DIFERENTE"
ADMIN_JWT_EXPIRES_IN="4h"

# ====================================
# CREDENCIALES ADMIN
# ====================================
ADMIN_USER="admin"
# Genera el hash con: node -e "console.log(require('bcrypt').hashSync('TuPasswordSeguro123', 10))"
ADMIN_PASSWORD_HASH="$2b$10$REEMPLAZAR_CON_HASH_GENERADO"

# ====================================
# MERCADO PAGO - PRODUCCIÓN
# ====================================
# ⚠️ IMPORTANTE: Usar credenciales de PRODUCCIÓN, NO de test
# Obtenerlas desde: https://www.mercadopago.cl/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN="APP_USR-REEMPLAZAR_CON_TOKEN_PRODUCCION"
MERCADOPAGO_PUBLIC_KEY="APP_USR-REEMPLAZAR_CON_PUBLIC_KEY_PRODUCCION"
MERCADOPAGO_WEBHOOK_SECRET="REEMPLAZAR_CON_WEBHOOK_SECRET"

# ====================================
# OPENAI
# ====================================
# Obtener desde: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-REEMPLAZAR_CON_TU_API_KEY"

# ====================================
# URLS DE PRODUCCIÓN
# ====================================
# Reemplazar con tu dominio real
FRONTEND_URL="https://tudominio.com"
BACKEND_URL="https://api.tudominio.com/api"

# Si usas solo IP temporal:
# FRONTEND_URL="http://46.202.145.196"
# BACKEND_URL="http://46.202.145.196/api"
