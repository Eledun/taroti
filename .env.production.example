# ============================================================================
# TAROTI LATAM - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo como .env en el servidor de producción
# 2. Reemplazar TODOS los valores XXX con las credenciales reales
# 3. NUNCA commitear el archivo .env a git
# ============================================================================

# --- Node.js Environment ---
NODE_ENV=production
PORT=3000

# --- Frontend URLs ---
# URL pública del sitio (sin trailing slash)
ORIGIN=https://taroti.mx
FRONTEND_URL=https://taroti.mx

# --- MySQL/MariaDB Database ---
MYSQL_HOST=localhost
MYSQL_USER=taroti_prod
MYSQL_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI_16PLUS_CHARS
MYSQL_DATABASE=taroti_latam
MYSQL_PORT=3306

# --- Mercado Pago PRODUCCIÓN ---
# Obtener en: https://www.mercadopago.com.mx/developers/panel/app
# IMPORTANTE: Usar credenciales de PRODUCCIÓN, NO de TEST
MP_ACCESS_TOKEN=APP-XXXXXXXXXXXXXXXXXXXXXXXX
MP_PUBLIC_KEY=APP-XXXXXXXXXXXXXXXXXXXXXXXX

# --- OpenAI API ---
# Obtener en: https://platform.openai.com/api-keys
# IMPORTANTE: Usar API key NUEVA (rotar la vieja si fue expuesta)
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Security ---
# Generar con: openssl rand -base64 32
SESSION_SECRET=CAMBIAR_GENERAR_STRING_RANDOM_32_CHARS_MINIMO

# --- Logging Level ---
# Opciones: error, warn, info, debug
LOG_LEVEL=info

# ============================================================================
# VARIABLES OPCIONALES (Descomentar si se necesitan)
# ============================================================================

# --- Rate Limiting ---
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=900000

# --- CORS ---
# CORS_ORIGIN=https://taroti.mx

# --- Analytics (Opcional) ---
# GA_TRACKING_ID=G-XXXXXXXXXX
# FB_PIXEL_ID=XXXXXXXXXXXXXXXXX

# ============================================================================
# CHECKLIST DE SEGURIDAD
# ============================================================================
# [ ] Cambiar TODOS los valores XXX por credenciales reales
# [ ] MP_ACCESS_TOKEN es de PRODUCCIÓN (comienza con APP-)
# [ ] OPENAI_API_KEY es NUEVA (rotar la vieja)
# [ ] SESSION_SECRET es string random de 32+ caracteres
# [ ] MYSQL_PASSWORD es fuerte (16+ caracteres, mayúsculas, minúsculas, números, símbolos)
# [ ] Archivo .env tiene permisos 600 (solo owner puede leer)
# [ ] Archivo .env NO está en .gitignore
# [ ] Archivo .env NO está commiteado a git
# ============================================================================
