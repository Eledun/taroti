# 🔮 Taroti Frontend - Variables de Entorno
# Copia este archivo a .env y completa con tus valores reales

# ========================================
# 🌐 API URLs
# ========================================
# Desarrollo local
PUBLIC_API_URL=http://localhost:4000/api

# Producción en Hostinger
# PUBLIC_API_URL=https://api.tudominio.com/api

# ========================================
# 💳 Mercado Pago
# ========================================
# Public Key (mismo en desarrollo y producción)
PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-aqui

# ========================================
# 🔑 Google OAuth (Opcional)
# ========================================
PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ========================================
# 📝 NOTAS IMPORTANTES
# ========================================
# 1. Solo variables con PUBLIC_ son accesibles en el cliente
# 2. En producción, PUBLIC_API_URL debe apuntar a tu dominio real
# 3. NUNCA pongas secrets del backend aquí (son públicos)
