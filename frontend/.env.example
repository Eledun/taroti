# 🔮 Taroti Frontend - Variables de Entorno (Arquitectura Simplificada)
# Copia este archivo a .env y completa con tus valores reales

# IMPORTANTE: Variables sin PUBLIC_ solo están disponibles en server endpoints
# Variables con PUBLIC_ están expuestas al cliente (¡NO pongas secrets aquí!)

# ========================================
# 💳 Mercado Pago - PRODUCCIÓN
# ========================================
# Obtener desde: https://www.mercadopago.cl/developers/panel/credentials

# Access Token (PRIVADO - solo server)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXXXX

# Public Key (puede ser público)
PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-XXXXXXXX

# Webhook Secret
MERCADOPAGO_WEBHOOK_SECRET=XXXXXXXX

# ========================================
# 🤖 OpenAI API
# ========================================
# Obtener desde: https://platform.openai.com/api-keys
# API Key (PRIVADO - solo server)
OPENAI_API_KEY=sk-proj-XXXXXXXX

# ========================================
# 🌐 URLs
# ========================================
# URL del frontend (para back_urls de Mercado Pago)
FRONTEND_URL=http://localhost:5173

# Para producción:
# FRONTEND_URL=https://dev.taroti.fun
# o
# FRONTEND_URL=http://46.202.145.196

# ========================================
# 📝 NOTAS IMPORTANTES
# ========================================
# 1. Solo variables con PUBLIC_ son accesibles en el cliente
# 2. NUNCA pongas API keys con prefijo PUBLIC_
# 3. Las variables sin PUBLIC_ solo funcionan en server endpoints (+server.ts)
